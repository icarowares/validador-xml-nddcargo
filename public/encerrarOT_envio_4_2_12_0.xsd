<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- ═══════════════════════════════════════════════════════════════
       encerrarOT_envio — Schema v4.2.12.0
       Layout de Encerramento de Operação de Transporte
       NDD Cargo · SOAP / ANTT
  ═══════════════════════════════════════════════════════════════ -->

  <!-- ─── Tipos simples ─────────────────────────────────────────── -->

  <xs:simpleType name="TVersao">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="7"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TToken">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="24"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TCnpj">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{14}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TNumCiot">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TCodVerif">
    <xs:restriction base="xs:string">
      <xs:length value="4"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TCodigoIBGE">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{7}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TCEP">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TLatLon">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="10"/>
      <xs:fractionDigits value="6"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TTotalKM">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TQtdeViagens">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="99999"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ─── pontoParada ────────────────────────────────────────────── -->
  <!-- [RN-E03] Exatamente um de: codigoIBGE, cep ou latitude+longitude -->

  <xs:complexType name="TPontoParada">
    <xs:choice>
      <xs:element name="codigoIBGE" type="TCodigoIBGE"/>
      <xs:element name="cep" type="TCEP"/>
      <xs:sequence>
        <xs:element name="latitude"  type="TLatLon"/>
        <xs:element name="longitude" type="TLatLon"/>
      </xs:sequence>
    </xs:choice>
  </xs:complexType>

  <!-- ─── informacoes (rota) ─────────────────────────────────────── -->

  <xs:complexType name="TInformacoesRota">
    <xs:sequence>
      <xs:element name="nome">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="tipoRotaPadrao" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:integer">
            <xs:enumeration value="1"/>
            <xs:enumeration value="2"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <!-- [RN-E04] Mínimo de 2 pontosParada -->
      <xs:element name="pontosParada">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="pontoParada" type="TPontoParada" minOccurs="2" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── rota ──────────────────────────────────────────────────── -->

  <xs:complexType name="TRota">
    <xs:sequence>
      <xs:element name="rotaERP">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="30"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="informacoes" type="TInformacoesRota" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── viagem (TACagregado) ──────────────────────────────────── -->

  <xs:complexType name="TViagem">
    <xs:sequence>
      <xs:element name="rota"         type="TRota"/>
      <xs:element name="totalKM"      type="TTotalKM"/>
      <xs:element name="qtdeViagens"  type="TQtdeViagens"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── encerramento ──────────────────────────────────────────── -->
  <!-- [RN-E01] Exatamente um de: lotacao, fracionado ou TACagregado -->

  <xs:complexType name="TEncerramento">
    <xs:choice>
      <xs:element name="lotacao">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="qtdeCarga">
              <xs:simpleType>
                <xs:restriction base="xs:decimal">
                  <xs:totalDigits value="12"/>
                  <xs:fractionDigits value="2"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- [RN-E02] encerrar deve ter valor 1 -->
      <xs:element name="fracionado">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="encerrar">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="1"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="TACagregado">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="viagens">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="viagem" type="TViagem" minOccurs="1" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <!-- ─── Elemento raiz ─────────────────────────────────────────── -->

  <xs:element name="encerrarOT_envio">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="infEnceOT">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="cnpj" type="TCnpj"/>
              <xs:element name="autorizacao">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ciot">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="numero"             type="TNumCiot"/>
                          <xs:element name="ciotCodVerificador" type="TCodVerif"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="encerramento" type="TEncerramento"/>
            </xs:sequence>
            <!-- ID ou Id: GUID para assinatura digital (ambos opcionais) -->
            <xs:attribute name="ID" type="xs:string" use="optional"/>
            <xs:attribute name="Id" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
        <!-- Assinatura digital obrigatória -->
        <xs:any namespace="##other" processContents="lax"/>
      </xs:sequence>
      <xs:attribute name="versao" type="TVersao" use="required"/>
      <xs:attribute name="token"  type="TToken"  use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
