<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           elementFormDefault="qualified">

  <!-- ═══════════════════════════════════════════════════════════════
       alterarOT_envio — Schema v4.2.12.0
       Layout de Retificação (Alteração) de Operação de Transporte
       NDD Cargo · SOAP / ANTT
  ═══════════════════════════════════════════════════════════════ -->

  <!-- ─── Tipos simples ─────────────────────────────────────────── -->

  <xs:simpleType name="TVersao">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="7"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TToken">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="24"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TCnpj">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{14}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TCpf">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{11}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TData">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TDataHora">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TValor">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="17"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TNumCiot">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TCodVerif">
    <xs:restriction base="xs:string">
      <xs:length value="4"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TCodigoSH">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TQuantidade10v2">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="12"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 1-Granel sólido … 12-Granel Pressurizada -->
  <xs:simpleType name="TCodigoTipoCarga">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="12"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TRubrica4">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="4"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TRubrica3">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TPrazoMinimo">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ─── Tipo: retenções de impostos ────────────────────────────── -->

  <xs:complexType name="TRetencoes">
    <xs:sequence>
      <xs:element name="irrf"      type="TValor"/>
      <xs:element name="inss"      type="TValor"/>
      <xs:element name="sestsenat" type="TValor"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TRetencoesComRubrica">
    <xs:sequence>
      <xs:element name="irrf"      type="TValor"/>
      <xs:element name="inss"      type="TValor"/>
      <xs:element name="sestsenat" type="TValor"/>
      <xs:element name="rubrica"   type="TRubrica3"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── Tipo: dados bancários ───────────────────────────────────── -->

  <xs:complexType name="TDadosBancarios">
    <xs:sequence>
      <xs:element name="codigoInstituicaoFinanceira" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="3"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="numeroAgencia" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="6"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="numeroConta" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="20"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="digitoConta" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="chavePix" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="64"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="tipoChave" minOccurs="0">
        <!-- 1=Email 2=CPF/CNPJ 3=Telefone 4=Aleatório 5=Dados Bancários -->
        <xs:simpleType>
          <xs:restriction base="xs:integer">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="5"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── Tipo: ANTT ──────────────────────────────────────────────── -->

  <xs:complexType name="TANTT">
    <xs:choice>
      <!-- OT fracionado: permite alterar a carga -->
      <xs:element name="fracionado">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="carga" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="codigoSH"        type="TCodigoSH"        minOccurs="0"/>
                  <xs:element name="quantidade"       type="TQuantidade10v2"  minOccurs="0"/>
                  <xs:element name="CodigoTipoCarga"  type="TCodigoTipoCarga" minOccurs="0"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- OT TAC-Agregado: permite alterar a data de fim -->
      <xs:element name="TACagregado">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="dtFim" type="TData"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <!-- ─── Tipo: tipoPgto ──────────────────────────────────────────── -->

  <xs:complexType name="TTipoPgto">
    <xs:choice>
      <xs:element name="manual">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="dataPrevisao" type="TData"/>
            <xs:element name="efetivacao" minOccurs="0">
              <!-- 1=Posto 2=Triagem 3=Contratante 4=Eletrônico -->
              <xs:simpleType>
                <xs:restriction base="xs:integer">
                  <xs:minInclusive value="1"/>
                  <xs:maxInclusive value="4"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="automatico">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="dataHora" type="TDataHora"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- imediato: valor fixo 2 -->
      <xs:element name="imediato">
        <xs:simpleType>
          <xs:restriction base="xs:integer">
            <xs:enumeration value="2"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <!-- ─── Tipo: novaParc ──────────────────────────────────────────── -->

  <xs:complexType name="TNovaParc">
    <xs:sequence>
      <xs:element name="nome">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="tipoPgto" type="TTipoPgto"/>
      <xs:element name="valorAplicado" type="TValor"/>
      <xs:element name="valorReal"     type="TValor" minOccurs="0"/>
      <xs:element name="descontos" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="desconto" maxOccurs="unbounded">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="nmDesc">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:minLength value="1"/>
                        <xs:maxLength value="50"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="vlrDesc" type="xs:string" minOccurs="0"/>
                  <xs:element name="dsDesc"  type="xs:string" minOccurs="0"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="retencoes" type="TRetencoesComRubrica" minOccurs="0"/>
      <xs:element name="prazoMinimo"   type="TPrazoMinimo" minOccurs="0"/>
      <xs:element name="confirmarPgto" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:integer">
            <xs:enumeration value="1"/>
            <xs:enumeration value="2"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="transferenciaAutomatica" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="cpfCondutor"     type="TCpf"/>
            <xs:element name="finalidadeParcela">
              <!-- 1=Adiantamento 2=Saldo -->
              <xs:simpleType>
                <xs:restriction base="xs:integer">
                  <xs:enumeration value="1"/>
                  <xs:enumeration value="2"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── Tipo: altValores ────────────────────────────────────────── -->

  <xs:complexType name="TAltValores">
    <xs:sequence>
      <xs:choice>
        <xs:element name="adicional">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="valor"   type="TValor"/>
              <xs:element name="rubrica" type="TRubrica4"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="desconto">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="nmDesc">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                    <xs:maxLength value="50"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="vlrDesc" type="xs:string" minOccurs="0"/>
              <xs:element name="dsDesc"  type="xs:string" minOccurs="0"/>
              <xs:element name="rubrica" type="TRubrica4" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="retencoes"         type="TRetencoes"/>
        <xs:element name="descontoRetencoes"  type="TRetencoes"/>
      </xs:choice>
      <xs:element name="valorValidacao" type="TValor" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── Tipo: ajustaParc ────────────────────────────────────────── -->

  <xs:complexType name="TAjustaParc">
    <xs:sequence>
      <xs:element name="nome">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="altData" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="data" type="TDataHora"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="altValores"    type="TAltValores" minOccurs="0"/>
      <xs:element name="prazoMinimo"   type="TPrazoMinimo" minOccurs="0"/>
      <xs:element name="confirmarPgto" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:integer">
            <xs:enumeration value="1"/>
            <xs:enumeration value="2"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="transferenciaAutomatica" minOccurs="0">
        <xs:complexType>
          <xs:choice>
            <xs:element name="novaConfiguracao">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="cpfCondutor"      type="TCpf"/>
                  <xs:element name="finalidadeParcela">
                    <xs:simpleType>
                      <xs:restriction base="xs:integer">
                        <xs:enumeration value="1"/>
                        <xs:enumeration value="2"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="removerConfiguracao">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="cpfCondutor" type="TCpf"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <xs:element name="dadosBancarios" type="TDadosBancarios" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── Tipo: financeiro ────────────────────────────────────────── -->

  <xs:complexType name="TFinanceiro">
    <xs:choice>
      <xs:element name="novaParc"   type="TNovaParc"/>
      <xs:element name="ajustaParc" type="TAjustaParc"/>
    </xs:choice>
  </xs:complexType>

  <!-- ─── Tipo: adicionais ────────────────────────────────────────── -->

  <xs:complexType name="TAdicionais">
    <xs:sequence>
      <xs:element name="campo" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="nome">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:minLength value="1"/>
                  <xs:maxLength value="255"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="valor">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:minLength value="1"/>
                  <xs:maxLength value="2000"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── Tipo: semMF ─────────────────────────────────────────────── -->

  <xs:complexType name="TSemMF">
    <xs:sequence>
      <xs:element name="valores">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="vlrFrete" type="TValor" minOccurs="0"/>
            <xs:element name="despesas" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="vlrDespesas" type="TValor"/>
                  <xs:element name="descricao">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:minLength value="1"/>
                        <xs:maxLength value="2000"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="retencoes" type="TRetencoes" minOccurs="0"/>
            <xs:element name="vlrCombustivel" type="TValor" minOccurs="0"/>
            <xs:element name="vlrPedagio"     type="TValor" minOccurs="0"/>
            <xs:element name="desconto" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="nmDesc">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:minLength value="1"/>
                        <xs:maxLength value="50"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="vlrDesc" type="xs:string"/>
                  <xs:element name="rubrica"  type="TRubrica4"/>
                  <xs:element name="dsDesc"  type="xs:string" minOccurs="0"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── Tipo: documentoOriginario ──────────────────────────────── -->

  <xs:complexType name="TDocumentoOriginario">
    <xs:sequence>
      <xs:element name="tipo">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="40"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="numero">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="44"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ─── Elemento raiz ────────────────────────────────────────────── -->

  <xs:element name="alterarOT_envio">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="OT" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="infOT">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="cnpj" type="TCnpj"/>
                    <xs:element name="autorizacao">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ciot">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="numero"             type="TNumCiot"/>
                                <xs:element name="ciotCodVerificador" type="TCodVerif"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="alteracoes">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="alteracao" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:choice>
                                  <xs:element name="ANTT"       type="TANTT"/>
                                  <xs:element name="financeiro" type="TFinanceiro"/>
                                  <xs:element name="adicionais" type="TAdicionais"/>
                                  <xs:element name="semMF"      type="TSemMF"/>
                                </xs:choice>
                                <xs:element name="documentoOriginario" type="TDocumentoOriginario" minOccurs="0"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="motivo">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:minLength value="1"/>
                          <xs:maxLength value="1000"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                  </xs:sequence>
                  <!-- ID ou Id: GUID para assinatura digital (ambos opcionais) -->
                  <xs:attribute name="ID" type="xs:string" use="optional"/>
                  <xs:attribute name="Id" type="xs:string" use="optional"/>
                </xs:complexType>
              </xs:element>
              <!-- Assinatura digital obrigatória -->
              <xs:any namespace="##other" processContents="lax"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="versao" type="TVersao" use="required"/>
      <xs:attribute name="token"  type="TToken"  use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
